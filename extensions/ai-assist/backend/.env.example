# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── LLM API Keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── Default Model Settings ────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen3:32b
DEFAULT_SEGMENTATION_MODEL=totalsegmentator

# ── Ollama ────────────────────────────────────────────────────────────────────
# The server must expose an OpenAI-compatible API (/models + /chat/completions).
# Local Ollama:  OLLAMA_BASE_URL=http://localhost:11434/v1
# Remote server: OLLAMA_BASE_URL=https://maia-chat.app.cloud.cbh.kth.se/api
OLLAMA_BASE_URL=https://maia-chat.app.cloud.cbh.kth.se/api
# Bearer token for remote servers that require authentication (leave blank for local)
# OLLAMA_API_KEY=your-token-here

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for development only)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Custom Segmentation Endpoints ─────────────────────────────────────────────
# Format: "model-id:http://endpoint-url"  (comma-separated for multiple)
# CUSTOM_SEG_ENDPOINTS=my-liver:http://localhost:9001,my-tumor:http://localhost:9002

# ── TotalSegmentator ──────────────────────────────────────────────────────────
TOTALSEGMENTATOR_TASK=total
TOTALSEGMENTATOR_FAST=false

# ── DICOMweb ──────────────────────────────────────────────────────────────────
# These mirror the OHIF data source configuration fields.  Copy the values
# from your appConfig.js / default.js configuration block.
# The OHIF viewer sends them automatically in every chat request; these env
# vars are the fallback for scripted / API usage without a live OHIF session.
#
# Example — AWS S3 static WADO server (CloudFront):
# DICOMWEB_WADO_ROOT=https://d14fa38qiwhyfd.cloudfront.net/dicomweb
# DICOMWEB_QIDO_ROOT=https://d14fa38qiwhyfd.cloudfront.net/dicomweb
# DICOMWEB_WADO_URI_ROOT=https://d14fa38qiwhyfd.cloudfront.net/dicomweb
# DICOMWEB_STATIC_WADO=true
# DICOMWEB_SINGLEPART=bulkdata,video
#
# Example — Orthanc:
# DICOMWEB_WADO_ROOT=http://orthanc:8042/wado
# DICOMWEB_QIDO_ROOT=http://orthanc:8042/wado
#
# Example — dcm4chee:
# DICOMWEB_WADO_ROOT=http://localhost:8080/dcm4chee-arc/aets/DCM4CHEE/rs
# DICOMWEB_QIDO_ROOT=http://localhost:8080/dcm4chee-arc/aets/DCM4CHEE/rs
#
# Backward-compat shortcut (sets all three roots to the same URL):
# DICOMWEB_URL=http://orthanc:8042/wado

# ── Chat History ───────────────────────────────────────────────────────────────
# Directory where per-study chat history JSON files are stored when the frontend
# uses the "Server (local path)" storage option.
# Each study is stored as <CHAT_HISTORY_DIR>/<StudyInstanceUID>.json
# CHAT_HISTORY_DIR=/tmp/ohif-ai-chat-history
