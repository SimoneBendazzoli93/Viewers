# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── LLM API Keys ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── Default Model Settings ────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen3:32b
DEFAULT_SEGMENTATION_MODEL=totalsegmentator

# ── Ollama ────────────────────────────────────────────────────────────────────
# Local:  OLLAMA_BASE_URL=http://localhost:11434
# Remote: OLLAMA_BASE_URL=https://maia-chat.app.cloud.cbh.kth.se/api
OLLAMA_BASE_URL=https://maia-chat.app.cloud.cbh.kth.se/api

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * for development only)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Custom Segmentation Endpoints ─────────────────────────────────────────────
# Format: "model-id:http://endpoint-url"  (comma-separated for multiple)
# CUSTOM_SEG_ENDPOINTS=my-liver:http://localhost:9001,my-tumor:http://localhost:9002

# ── TotalSegmentator ──────────────────────────────────────────────────────────
TOTALSEGMENTATOR_TASK=total
TOTALSEGMENTATOR_FAST=false
