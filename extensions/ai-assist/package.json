{
  "name": "@ohif/extension-ai-assist",
  "version": "3.12.0-beta.132",
  "description": "AI Agent Assistant for automated report generation, radiomics extraction, and organ segmentation in OHIF Viewer",
  "author": "OHIF",
  "license": "MIT",
  "main": "dist/ohif-extension-ai-assist.umd.js",
  "module": "src/index.tsx",
  "files": [
    "dist/**",
    "src/**",
    "README.md"
  ],
  "repository": "OHIF/Viewers",
  "keywords": [
    "ohif-extension",
    "ai",
    "agent",
    "segmentation",
    "radiomics",
    "report"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14",
    "npm": ">=6",
    "yarn": ">=1.18.0"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "clean:deep": "yarn run clean && shx rm -rf node_modules",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "build:package-1": "yarn run build",
    "start": "yarn run dev"
  },
  "peerDependencies": {
    "@ohif/core": "3.12.0-beta.132",
    "@ohif/extension-default": "3.12.0-beta.132",
    "@ohif/ui-next": "3.12.0-beta.132",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@babel/runtime": "7.28.2"
  }
}
